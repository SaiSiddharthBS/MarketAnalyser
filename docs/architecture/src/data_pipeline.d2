direction: right

classes: {
  api: { style: { fill: "#051114"; stroke: "#f59e0b"; font-color: "#f59e0b"; border-radius: 4; stroke-dash: 5 } }
  process: { style: { fill: "#051114"; stroke: "#38bdf8"; font-color: "#38bdf8"; border-radius: 8; stroke-width: 2 } }
  db: { shape: cylinder; style: { fill: "#051114"; stroke: "#0ea5e9"; font-color: "#0ea5e9" } }
  quarantine: { style: { fill: "#051114"; stroke: "#ff3366"; font-color: "#ff3366"; border-radius: 4; stroke-width: 2 } }
  engine: { style: { fill: "#00FF88"; font-color: "#051114"; stroke: transparent; shadow: true; border-radius: 8 } }
}

"yfinance / External APIs": { class: api }

"Data Fetcher (Cron)": { class: process }

"Validation Gateway": {
  class: process
  shape: diamond
}

"Bad Tick Quarantine": { class: quarantine }

"SQLite Local Cache": { class: db }

"Machine Learning Ensemble": { class: engine }

# Flow
"yfinance / External APIs" -> "Data Fetcher (Cron)": { label: "Raw OHLCV"; style: { stroke: "#f59e0b"; animated: true } }

"Data Fetcher (Cron)" -> "Validation Gateway": { style: { stroke: "#38bdf8" } }

"Data Fetcher (Cron)" -> "yfinance / External APIs": { label: "Exponential Backoff Retry"; style: { stroke: "#ff3366"; stroke-dash: 5 } }

"Validation Gateway" -> "Bad Tick Quarantine": { label: "Invalid/Spike"; style: { stroke: "#ff3366" } }
"Validation Gateway" -> "SQLite Local Cache": { label: "Valid Tick (Save)"; style: { stroke: "#00FF88" } }

"SQLite Local Cache" -> "Machine Learning Ensemble": { label: "Verified Data Vector"; style: { stroke: "#00FF88"; animated: true; stroke-width: 2 } }

# Fallback path
"Validation Gateway" -> "SQLite Local Cache": { label: "API Timeout Fallback"; style: { stroke: "#f59e0b"; stroke-dash: 5 } }
