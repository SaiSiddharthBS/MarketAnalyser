direction: down

classes: {
  macbook: { style: { fill: "#051114"; stroke: "#38bdf8"; font-color: "#38bdf8"; border-radius: 8; stroke-width: 2 } }
  dell: { style: { fill: "#051114"; stroke: "#ff3366"; font-color: "#ff3366"; border-radius: 8; stroke-width: 2 } }
  cloud: { style: { fill: "#051114"; stroke: "#f59e0b"; font-color: "#f59e0b"; border-radius: 8; stroke-width: 2; stroke-dash: 5 } }
  node_item: { style: { fill: "transparent"; stroke: "transparent"; font-color: "#e2e8f0" } }
  docker_box: { style: { fill: "#051114"; stroke: "#0ea5e9"; font-color: "#0ea5e9"; border-radius: 4; stroke-dash: 3 } }
}

"Node 1: Executive Dashboard (MacBook Pro)": {
  class: macbook
  "Obsidian Glass UI (Local PWA)": { class: node_item }
  "Codebase & Strategy Architecture": { class: node_item }
  "Google Chrome / Safari (60 FPS)": { class: node_item }
}

"Node 2: The Sentinel Node (Always-On Laptop)": {
  class: dell
  "Docker Engine": {
    class: docker_box
    "FastAPI Uvicorn Backend": { class: node_item }
    "Background Scheduler Daemon": { class: node_item }
    "15-Model Quant Engine": { class: node_item }
  }
  "Ollama Local Daemon (LLaMA 3.3 70B)": { class: node_item }
}

"Cloud Infrastructure": {
  class: cloud
  "Neon PostgreSQL (Serverless Cluster)": { class: node_item; shape: cylinder }
  "Telegram API": { class: node_item }
  "yfinance / FRED APIs": { class: node_item }
}

