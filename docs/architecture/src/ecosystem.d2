direction: down
classes: {
  core: {
    style: {
      fill: "#051114"
      stroke: "#00FF88"
      font-color: "#00FF88"
      stroke-width: 2
      border-radius: 8
    }
  }
  risk: {
    style: {
      fill: "#051114"
      stroke: "#ff3366"
      font-color: "#ff3366"
      stroke-width: 2
      border-radius: 8
    }
  }
  infra: {
    style: {
      fill: "#051114"
      stroke: "#38bdf8"
      font-color: "#38bdf8"
      stroke-width: 2
      border-radius: 8
    }
  }
  external: {
    style: {
      fill: "#051114"
      stroke: "#f59e0b"
      font-color: "#f59e0b"
      stroke-width: 2
      border-radius: 8
      stroke-dash: 5
    }
  }
}

"Agent Alpha": {
  shape: cylinder
  style: {
    fill: "#00FF88"
    font-color: "#051114"
    stroke: transparent
    shadow: true
  }
}

"Engine Core": {
  class: core
  "15-Model Ensemble"
  "XGBoost & LightGBM"
  "Statistical Arbitrage"
}

"Risk Management": {
  class: risk
  "HMM Regime Classifier"
  "12-Rule Veto Firewall"
  "Sector Correlation Heatmap"
  "ATR & Kelly Position Sizing"
}

"Data & Infrastructure": {
  class: infra
  "Ollama Local Daemon"
  "LLaMA 3.3 70B Versatile"
  "Neon PostgreSQL"
  "Docker Containerization"
  "Decoupled Cron Daemons"
}

"Execution & Reporting": {
  class: infra
  "Paper Trading Arena"
  "₹10L Starting Capital"
  "Telegram Bot Alerts"
  "Obsidian Glass UI"
}

"External Data": {
  class: external
  "yfinance APIs"
  "FRED Macro Data"
}

"Agent Alpha" -> "Engine Core": { style: { stroke: "#00FF88"; animated: true } }
"Agent Alpha" -> "Risk Management": { style: { stroke: "#ff3366" } }
"Agent Alpha" -> "Data & Infrastructure": { style: { stroke: "#38bdf8" } }
"Agent Alpha" -> "Execution & Reporting": { style: { stroke: "#38bdf8" } }

"Data & Infrastructure" -> "External Data": { style: { stroke: "#f59e0b"; animated: true } }
"Engine Core" -> "Risk Management": { style: { stroke: "#ff3366"; animated: true } }
"Risk Management" -> "Execution & Reporting": { style: { stroke: "#00FF88"; animated: true } }
