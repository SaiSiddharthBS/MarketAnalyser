# MarketPulse - Agent Alpha Configuration
# Copy this to .env and fill in your values

# Telegram Bot (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# FRED API (free: https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_key_here

# Server
ENVIRONMENT=development  # 'development' for MacBook, 'production' for Dell
ROLE=development         # 'development' for MacBook, 'master_executor' for Dell

HOST=0.0.0.0
PORT=8000

# Database Cloud Connections (NeonDB)
DATABASE_URL_PROD=your_neondb_production_url_here
DATABASE_URL_DEV=your_neondb_development_url_here
